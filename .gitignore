target/
# El Maven wrapper se versiona: mvnw + .mvn/wrapper/maven-wrapper.properties.
# (Se re-incluye el subdirectorio porque git no desciende a un dir ignorado.)
.mvn/*
!.mvn/wrapper/
.mvn/wrapper/*
!.mvn/wrapper/maven-wrapper.properties
*.class
*.log
.env
.env.local
.DS_Store
.idea/
*.iml
.vscode/
build/
.worktrees/
# Scratch de subagent-driven-development (ledger, briefs, reports). No se versiona.
.superpowers/

# Artefactos de Playwright MCP (capturas, snapshots, consola). No se versionan.
.playwright-mcp/

# Un `.env.bak.<epoch>` se coló versionado 12 dias en el starter kit (2026-08-07 al
# 08-19) con la contrasena de la base, el secreto de firma y el par de llaves de R2.
# Los patrones que habia —`.env`, `.env.local`— no lo atrapaban. Este si.
.env*
!.env.example

# Insumos de trabajo real con cotizaciones a clientes (correo real, datos de negocio).
# Sin trackear hasta ahora por suerte, no por diseño (auditoría de documentación,
# 2026-08-28) — un `git add .` distraído los metía al historial y de ahí no salen sin
# reescribirlo. No se borran ni se mueven: la decisión sobre estos datos es de Felipe.
cotizacion-*.json
crear-cotizacion-*.sh
ver-cotizacion.sh
