# --- Database (Railway Postgres plugin inyecta DATABASE_URL / PG* automaticamente) ---
# Para local con docker:  docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cotizaciones postgres:16
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cotizaciones
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT ---
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-64-caracteres-aqui
JWT_ADMIN_TTL=480
JWT_CLIENT_TTL=30

# --- Admin bootstrap (se siembra al primer arranque, luego se ignora) ---
ADMIN_BOOTSTRAP_EMAIL=felipe@webiados.com
ADMIN_BOOTSTRAP_PASSWORD=cambia-esta-clave

# --- Email (Resend, único camino — migrado desde Gmail SMTP el 2026-09-04). Ver
# docs/correo-resend.md. Llave dedicada a este servicio, no la de otro flujo del ecosistema.
RESEND_API_KEY=re_tu_llave_dedicada_a_este_servicio
RESEND_WEBHOOK_SECRET=whsec_lo_que_de_resend_al_configurar_el_endpoint
MAIL_FROM=contacto@webiados.com
NOTIFY_TO=contacto@webiados.com

# --- Negocio ---
QUOTE_VALIDITY_DAYS=15
# Base de la landing que ve el cliente (la sirve el frontend Angular).
QUOTE_PUBLIC_BASE_URL=https://webiados.com/cotizacion

# --- Catálogo de precios (Core) ---
# Fuente de verdad: pricing.md. El Core la publica ya calculada (UF/neto/conIva/USD del día).
# Este servicio la consume verbatim; no convierte. Si el Core no responde, sirve el último cacheado.
PRICING_URL=https://core.webiados.com/api/v1/pricing
PRICING_TIMEOUT_SECONDS=5

# --- Leads (CRM del Core) ---
# El formulario público postea al Core; acá se LEE un lead al convertirlo en cotización.
# CORE_API_KEY: llave de tenant del Core (Bearer wcore_live_...). Sin ella, convertir un lead
# falla con aviso, pero el servicio arranca igual (la conversión de leads es opcional).
LEADS_URL=https://core.webiados.com/api/v1/leads
CORE_API_KEY=
LEADS_TIMEOUT_SECONDS=5

# --- CORS ---
# OJO: cotiza.webiados.com resuelve (2026-08-19) pero apunta a esta API en Railway, no al
# frontend. El panel y la landing viven en webiados.com; por eso no va en esta lista.
CORS_ALLOWED_ORIGINS=https://webiados.com,https://www.webiados.com,http://localhost:4200
